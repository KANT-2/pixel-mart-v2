# 복사해서 backend/.env 로 사용하세요 (.env는 Git에 올리지 않습니다)
# local = 개발용 로그인·개발자 API 켜짐 / 배포에서는 production (그 둘은 404, 쿠키는 https 전용)
ENV=local

# 로컬 PostgreSQL (설치형: 5432 / docker compose: 5433)
DATABASE_URL=postgresql+asyncpg://pixelmart:pixelmart@localhost:5432/pixelmart

# 로컬 전용 비밀값 — 아무 긴 문자열로 바꿔도 됩니다
# ⚠️ 배포(ENV=production)에서는 이 기본값이면 서버가 시작을 거부해요 → 배포 서비스 환경 변수 화면에 32자 이상 새 값을 넣기
JWT_SECRET=local-dev-secret-change-me-please-32chars

# 배포에서는 프론트 주소 (CORS 허용 · 구글 콜백 주소 = <FRONTEND_URL>/api/auth/google/callback)
FRONTEND_URL=http://localhost:3000

# 구글 로그인 (Google Cloud Console에서 발급, 팀 채널로만 공유)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI 픽셀 아바타 (Cloudflare Workers AI, 무료 일일 할당) — 비워 두면 AI 만들기만 꺼짐. 키는 팀 채널로만 공유
# Cloudflare 대시보드 → AI → Workers AI → Use REST API 에서 Account ID 복사 + Workers AI API 토큰 만들기
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# 사용자별 1시간 AI 아바타 횟수 제한 (0 = 제한 없음)
AI_AVATAR_PER_HOUR=0

# 배포(Render) 시작 스크립트 scripts/render_start.sh 전용 — 로컬에서는 비워 두기
# ADMIN_EMAIL: 이 이메일로 먼저 가입한 계정을 시작할 때 관리자로 지정
ADMIN_EMAIL=
# SHOWCASE_EMAIL: 발표 시연 데이터를 채울 계정 (여러 개는 쉼표로, 한 번 로그인한 뒤부터)
SHOWCASE_EMAIL=
